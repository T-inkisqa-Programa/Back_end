###############################################################################
# T'inkisqa — Variables de entorno (copiar a `.env`)
#
#   cp .env.example .env
#
# Docker Compose lee automáticamente el archivo `.env` de esta carpeta.
###############################################################################

# ---------------------------------------------------------------------------
# PostgreSQL (una sola instancia, una base de datos por microservicio)
# ---------------------------------------------------------------------------
POSTGRES_USER=tinkisqa
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=tinkisqa

# ---------------------------------------------------------------------------
# Seguridad / JWT (mínimo 32 caracteres para HS256)
# ---------------------------------------------------------------------------
JWT_SECRET=change_me_dev_secret_with_at_least_32_chars
JWT_ISSUER=tinkisqa-iam
JWT_ACCESS_TTL_MINUTES=60
JWT_REFRESH_TTL_DAYS=7

# ---------------------------------------------------------------------------
# CORS (para el frontend Expo). Vacío o `*` permite cualquiera (solo dev).
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000

# ---------------------------------------------------------------------------
# Datos de demostración (SOLO desarrollo; nunca activar en producción)
# ---------------------------------------------------------------------------
# Crea las 3 cuentas de prueba del IAM (admin y dos usuarias verificadas).
IAM_SEED_ENABLED=true
# Crea las comunidades de plataforma y el muro inicial del Social Service.
SOCIAL_SEED_ENABLED=true

# ---------------------------------------------------------------------------
# Puertos (solo el Gateway se publica al exterior)
# ---------------------------------------------------------------------------
GATEWAY_PORT=8080

# ---------------------------------------------------------------------------
# Despliegue en Render (descomentar y ajustar con las URLs reales).
# Si se definen, el Gateway enruta a esas URLs en lugar de a los nombres Docker.
# ---------------------------------------------------------------------------
# IAM_URL=https://tinkisqa-iam.onrender.com
# SOCIAL_URL=https://tinkisqa-social.onrender.com
# CONTENT_URL=https://tinkisqa-content.onrender.com
# SERVICE_URL=https://tinkisqa-service.onrender.com
# ENGAGEMENT_URL=https://tinkisqa-engagement.onrender.com
